# =========================================================================
# Subrata Roy Portfolio — Environment Variables Configuration
# =========================================================================

# Resend API Key (Generate for free at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Optional: Sender email address
# By default, Resend provides 'onboarding@resend.dev' for free testing.
# Once you verify a custom domain on Resend, you can use e.g.:
# RESEND_FROM_EMAIL=Subrata Roy <contact@yourdomain.com>
RESEND_FROM_EMAIL=Subrata Roy Portfolio <onboarding@resend.dev>

# Recipient Email (Destination inbox)
CONTACT_RECIPIENT_EMAIL=roy417996@gmail.com

